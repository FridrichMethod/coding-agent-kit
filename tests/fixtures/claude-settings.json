{
  "statusLine": {
    "type": "command",
    "command": "node -e \"require(require('os').homedir() + '/.claude/coding-agent-kit/statusline.cjs').main()\""
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('os').homedir() + '/.claude/coding-agent-kit/notify.cjs').main()\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node -e \"require(require('os').homedir() + '/.claude/coding-agent-kit/check-git-hooks.cjs').main()\""
          }
        ]
      }
    ]
  }
}
