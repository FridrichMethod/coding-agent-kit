#!/bin/sh
# codex-config-sync [--check | --migrate-portable] PORTABLE LIVE
# Resolve Stow links without GNU readlink -f; paths may contain spaces.
set -eu

sync_script=$0
case "$sync_script" in
    */*) ;;
    *) sync_script=$(command -v "$sync_script") ;;
esac
sync_links=0
while [ -L "$sync_script" ]; do
    sync_links=$((sync_links + 1))
    if [ "$sync_links" -gt 40 ]; then
        echo "codex-config-sync: wrapper symlink loop" >&2
        exit 1
    fi
    sync_dir=$(CDPATH='' cd -P -- "$(dirname -- "$sync_script")" && pwd)
    sync_link=$(readlink "$sync_script")
    if command -v cygpath >/dev/null 2>&1; then
        sync_link=$(cygpath -u "$sync_link")
    fi
    case "$sync_link" in
        /*) sync_script=$sync_link ;;
        *) sync_script=$sync_dir/$sync_link ;;
    esac
done
sync_root=$(CDPATH='' cd -P -- "$(dirname -- "$sync_script")/../../../.." && pwd)
sync_kind=codex-config-sync
# shellcheck source=lib/sync-runtime.sh
. "$sync_root/lib/sync-runtime.sh"
