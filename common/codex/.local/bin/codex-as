#!/bin/bash
# codex-as NAME [CODEX_ARGS...] — invoked directly, like claude-as.
# Serial use only; no lock. Audited against codex-cli 0.162.1.

# This process keeps the caller's umask, variables, cwd and options intact.
umask 077
# Match the dotfiles terminal policy without changing native Codex output.
_codex_as_message() {
    if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] &&
        { [ "${DOTFILES_COLOR:-auto}" = always ] ||
            { [ "${DOTFILES_COLOR:-auto}" != never ] && [ -t "$2" ]; }; }; then
        printf '\033[%sm%s\033[0m\n' "$1" "$3" >&"$2"
    else
        printf '%s\n' "$3" >&"$2"
    fi
}
if [ "$#" -eq 0 ] || [ "$1" = --help ]; then
    _codex_as_message '1;36' 1 'Usage: codex-as NAME [codex arguments...]'
    printf '%s\n' \
        'Credentials: ~/.secrets/codex-NAME.json (complete JSON, owner-only 0600).' \
        'Shared home: ~/.codex; file authentication; no OAuth implementation.' \
        'Supports interactive, exec, resume and fork; NAME --help reaches Codex.' \
        'Refuses login/logout, profiles, remote/provider/auth overrides and unknown flags.' \
        'Missing account: confirm [y/N], device login in empty temporary home, save, launch.' \
        'First initialization asks separately, preserves/backups current file credentials.' \
        'Replaced auth links stop automatically; see recovery instructions.' \
        'Global symlink, NO concurrency protection or lock. Never switch while a client' \
        'is running or suspended, including other terminals, desktop and IDE extensions.' \
        'Requires Python 3.11+ (stdlib) and the audited Codex version 0.162.1.' \
        'Initialization and recovery: ~/dotfiles/docs/codex-as.md'
    [ "$#" -gt 0 ] && exit 0
    exit 2
fi

_codex_as_account=$1
shift
case $_codex_as_account in
    '' | *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*)
        _codex_as_message 31 2 'codex-as: invalid account name (use ASCII letters, digits, _ or -).'
        exit 2
        ;;
esac
if ! command -v python3 >/dev/null 2>&1; then
    _codex_as_message 31 2 'codex-as: Python 3.11+ is required for local JSON and file checks.'
    exit 1
fi
_codex_as_checker=$HOME/.local/lib/codex-as/check.py
if [ ! -r "$_codex_as_checker" ]; then
    _codex_as_message 31 2 'codex-as: missing ~/.local/lib/codex-as/check.py; reinstall the helper.'
    exit 1
fi
# Check args/environment before even invoking the executable's version probe.
_codex_as_mode=$(command python3 -I -B "$_codex_as_checker" preflight "$_codex_as_account" "$@") || exit "$?"
_codex_as_version=$(command \codex --version </dev/null) || exit "$?"
if [ "$_codex_as_version" != 'codex-cli 0.162.1' ]; then
    _codex_as_message 31 2 'codex-as: Codex version has changed; re-audit auth writes before enabling.'
    exit 1
fi
# Help/version queries never initialize or enroll an account. Only root queries
# are special: an exec prompt containing these words remains a prompt.
case "$*" in
    --help | -h | --version | -V) _codex_as_query=1 ;;
    *) _codex_as_query=0 ;;
esac
if [ "$_codex_as_query" = 0 ]; then
    command python3 -I -B "$_codex_as_checker" prepare "$_codex_as_account" || exit "$?"
fi
if [ "$_codex_as_mode" = interactive ]; then
    # This version otherwise reuses a long-lived shared app-server daemon.
    set -- --no-daemon "$@"
fi
if CODEX_HOME="$HOME/.codex" command \codex -c 'cli_auth_credentials_store="file"' "$@"; then
    _codex_as_result=0
else
    _codex_as_result=$?
fi
# Report replacement/damage without copying stale credentials back or changing
# Codex's exit status. The next invocation will also refuse the damaged state.
if [ "$_codex_as_query" = 0 ]; then
    command python3 -I -B "$_codex_as_checker" after "$_codex_as_account" || :
fi
exit "$_codex_as_result"
