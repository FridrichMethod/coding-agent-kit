#!/bin/bash
# codex-as NAME [CODEX_ARGS...] — invoked directly, like claude-as.
# Fixed account views; shared sessions. Audited against codex-cli 0.162.1.

# This process keeps the caller's umask, variables, cwd and options intact.
umask 077
# Match the dotfiles terminal policy without changing native Codex output.
_codex_as_message() {
    if [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ] &&
        { [ "${DOTFILES_COLOR:-auto}" = always ] ||
            { [ "${DOTFILES_COLOR:-auto}" != never ] && [ -t "$2" ]; }; }; then
        printf '\033[%sm%s\033[0m\n' "$1" "$3" >&"$2"
    else
        printf '%s\n' "$3" >&"$2"
    fi
}
if [ "$#" -eq 0 ] || [ "$1" = --help ]; then
    _codex_as_message '1;36' 1 'Usage: codex-as NAME [codex arguments...]'
    printf '%s\n' \
        'Credentials: ~/.secrets/codex-NAME.json (complete JSON, owner-only 0600).' \
        'Account home: ~/.codex/accounts/NAME; config/sessions/SQLite shared from ~/.codex.' \
        'Supports interactive, exec, resume and fork; NAME --help reaches Codex.' \
        'Refuses login/logout, profiles, remote/provider/auth overrides and unknown flags.' \
        'Missing account: confirm [y/N], device login in empty temporary home, save, launch.' \
        'Migration: codex-as --migrate DEFAULT_ACCOUNT (close root/desktop/IDE clients first).' \
        'Recovery: codex-as --recover NAME (idle account, explicit source and backups).' \
        'Concurrent accounts and different sessions are supported; native thread locks are shared.' \
        'Explicit resume UUID: confirm takeover from the root daemon, ending that session and its agents.' \
        'Interrupted takeover: keep its recovery record and retry the same resume UUID.' \
        'Same-account OAuth refresh retains native cross-process limitations.' \
        'Resume by UUID, --last or picker; explicit session names are refused.' \
        'Requires Python 3.11+ (stdlib) and the audited Codex version 0.162.1.' \
        'Initialization and recovery: ~/dotfiles/docs/codex-as.md'
    [ "$#" -gt 0 ] && exit 0
    exit 2
fi

case $1 in
    --migrate | --recover) _codex_as_account=${2-} ;;
    *) _codex_as_account=$1 ;;
esac
case $_codex_as_account in
    '' | *[!abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-]*)
        _codex_as_message 31 2 'codex-as: invalid account name (use ASCII letters, digits, _ or -).'
        exit 2
        ;;
esac
if ! command -v python3 >/dev/null 2>&1; then
    _codex_as_message 31 2 'codex-as: Python 3.11+ is required for local JSON and file checks.'
    exit 1
fi
_codex_as_launcher=$HOME/.local/lib/codex-as/launch.py
if [ ! -r "$_codex_as_launcher" ]; then
    _codex_as_message 31 2 'codex-as: missing ~/.local/lib/codex-as/launch.py; reinstall the helper.'
    exit 1
fi
exec python3 -I -B "$_codex_as_launcher" "$@"
