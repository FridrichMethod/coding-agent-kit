# shellcheck shell=bash
# bash-completion autoloads this file. Account names are metadata only:
# claude-as --list-accounts never starts native Claude. It keeps that 0.6
# spelling, which every release accepts, so a shell opened before an update
# or a rollback still completes. The own options count only as the first
# argument; after them and their arguments nothing is native.
_claude_as() {
    local words name word=${COMP_WORDS[COMP_CWORD]}
    COMPREPLY=()
    if [ "$COMP_CWORD" -eq 1 ]; then
        case $word in
            -*) words='--help --version --list --info --labels --label --show-config' ;;
            *) words=$(command claude-as --list-accounts 2>/dev/null) || return ;;
        esac
    elif [ "$COMP_CWORD" -eq 2 ]; then
        case ${COMP_WORDS[1]} in
            --info | -i | --account-info | --label | --set-label) words=$(command claude-as --list-accounts 2>/dev/null) || return ;;
            -*) return ;;
            *) words='--help --version --print --continue --resume' ;;
        esac
    elif [[ ${COMP_WORDS[1]} == -* ]]; then
        return
    elif declare -F _claude >/dev/null; then
        local COMP_WORDS=(claude "${COMP_WORDS[@]:2}") COMP_CWORD=$((COMP_CWORD - 1))
        local COMP_LINE COMP_POINT
        printf -v COMP_LINE '%q ' "${COMP_WORDS[@]}"
        COMP_POINT=${#COMP_LINE}
        _claude
        return
    else
        return
    fi
    while IFS= read -r name; do
        [ -n "$name" ] && COMPREPLY+=("$name")
    done < <(compgen -W "$words" -- "$word")
}
complete -F _claude_as claude-as
