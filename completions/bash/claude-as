# shellcheck shell=bash
# bash-completion autoloads this file; metadata only, no CLI invocation.
_claude_as() {
    local names name
    if [ "$COMP_CWORD" -eq 1 ]; then
        names=$(python3 -I -B "$HOME/.local/lib/claude-as/launch.py" --list-accounts 2>/dev/null) || return
        COMPREPLY=()
        while IFS= read -r name; do
            [ -n "$name" ] && COMPREPLY+=("$name")
        done < <(compgen -W "$names" -- "${COMP_WORDS[COMP_CWORD]}")
    elif [ "$COMP_CWORD" -eq 2 ]; then
        COMPREPLY=()
        while IFS= read -r name; do
            COMPREPLY+=("$name")
        done < <(compgen -W '--help --version --print --continue --resume' -- "${COMP_WORDS[COMP_CWORD]}")
    elif declare -F _claude >/dev/null; then
        local COMP_WORDS=(claude "${COMP_WORDS[@]:2}") COMP_CWORD=$((COMP_CWORD - 1))
        local COMP_LINE COMP_POINT
        printf -v COMP_LINE '%q ' "${COMP_WORDS[@]}"
        COMP_POINT=${#COMP_LINE}
        _claude
    fi
}
complete -F _claude_as claude-as
