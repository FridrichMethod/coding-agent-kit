#compdef codex-as

local -a names suggestions flags=(--reserve-5h --reserve-weekly)
local i=2 percent='^(off|0*(100(\.0*)?|[0-9]?[0-9](\.[0-9]*)?|\.[0-9]+))$'
local MATCH MBEGIN MEND
local -a match mbegin mend
# The reserve flags, each at most once and with its value (off or a percentage
# from 0 to 100), precede NAME in either order: skip them, so that word i comes
# after them.
while ((i < CURRENT)) && [[ -n ${(M)flags:#$words[i]} ]]; do
    flags=(${flags:#$words[i]})
    ((i += 2))
    ((i > CURRENT)) || [[ ${words[i - 1]} =~ $percent ]] || return 1
done
if ((i > CURRENT)); then
    # A value: off or a percentage, every tenth one until a digit is typed.
    [[ $words[CURRENT] == -* ]] && return 1
    if [[ -n $words[CURRENT] ]]; then
        suggestions=({0..100})
    else
        suggestions=({0..100..10})
    fi
    suggestions=('off:disable the check of this window' $suggestions)
    _describe -t reserve-values -V 'percentage to keep, or off' suggestions
    return
fi
if ((i == CURRENT)) && [[ $words[CURRENT] == -* ]]; then
    # The own options count only as the first argument; a reserve flag not yet
    # given may follow the others.
    if ((i == 2)); then
        suggestions=(
            '--help:show this help'
            '--version:show the kit version'
            '--list:list the account names'
            '--info:show the last-seen details of an account'
            '--labels:list the accounts with their emails'
            '--show-config:show the configuration in effect'
        )
    fi
    ((${flags[(Ie)--reserve-5h]})) && suggestions+=('--reserve-5h:keep this percentage of the 5-hour limit')
    ((${flags[(Ie)--reserve-weekly]})) && suggestions+=('--reserve-weekly:keep this percentage of the weekly limit')
    ((${#suggestions})) || return 1
    _describe -t options 'codex-as options' suggestions
    return
fi
if ((i == CURRENT)) || { ((i == 2 && CURRENT == 3)) && [[ $words[2] == (--info|-i|--account-info) ]]; }; then
    # Metadata only: codex-as --account-labels never starts native Codex, reads
    # a credential, logs in or reads quota. NAME<TAB>LABEL lines become
    # NAME:LABEL descriptions. The 0.6 spelling keeps a rollback completing.
    names=("${(@f)$(command codex-as --account-labels 2>/dev/null)}")
    names=("${(@)names:#}")
    names=("${(@)names/$'\t'/:}")
    ((${#names})) && _describe -t accounts 'Codex accounts' names
    return
fi
# After an own option and its arguments, or a dash word in place of NAME,
# nothing is native.
[[ $words[i] == -* ]] && return 1
if ((CURRENT == i + 1)); then
    suggestions=('exec:execute a prompt' 'resume:resume a shared session' 'fork:fork a session' '--help:show CLI help' '--version:show CLI version')
    _describe 'Codex arguments' suggestions
elif (($+functions[_codex])); then
    # The native words after NAME.
    local -a words=("${words[@]}")
    local CURRENT=$CURRENT
    words[2,i]=()
    words[1]=codex
    ((CURRENT -= i - 1))
    _codex
else
    _default
fi
