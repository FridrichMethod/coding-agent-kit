#compdef codex-as

local -a names suggestions
if ((CURRENT == 2)) && [[ $words[CURRENT] == -* ]]; then
    # The own options count only here, as the first argument.
    suggestions=(
        '--help:show this help'
        '--version:show the kit version'
        '--list:list the account names'
        '--info:show the last-seen details of an account'
        '--labels:list the accounts with their emails'
        '--show-config:show the configuration in effect'
    )
    _describe -t options 'codex-as options' suggestions
    return
fi
if ((CURRENT == 2)) || { ((CURRENT == 3)) && [[ $words[2] == (--info|-i|--account-info) ]]; }; then
    # Metadata only: codex-as --account-labels never starts native Codex or reads
    # a credential. NAME<TAB>LABEL lines become NAME:LABEL descriptions. The
    # 0.6 spelling keeps a rollback completing.
    names=("${(@f)$(command codex-as --account-labels 2>/dev/null)}")
    names=("${(@)names:#}")
    names=("${(@)names/$'\t'/:}")
    ((${#names})) && _describe -t accounts 'Codex accounts' names
    return
fi
# After an own option and its arguments nothing is native.
[[ $words[2] == -* ]] && return 1
if ((CURRENT == 3)); then
    suggestions=('exec:execute a prompt' 'resume:resume a shared session' 'fork:fork a session' '--help:show CLI help' '--version:show CLI version')
    _describe 'Codex arguments' suggestions
elif (($+functions[_codex])); then
    local -a words=("${words[@]}")
    local CURRENT=$CURRENT
    words[2]=()
    words[1]=codex
    ((CURRENT--))
    _codex
else
    _default
fi
